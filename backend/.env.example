# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/stocksense

# JWT Secret for authentication (required in production)
SECRET_KEY=your-super-secret-jwt-key-change-this

# Backward compatibility: if SECRET_KEY is not set, JWT_SECRET is also supported
# JWT_SECRET=your-super-secret-jwt-key-change-this

# Optional: ML Service URL
ML_SERVICE_URL=http://localhost:8001
